# Copie para .env (que fica fora do git) e preencha. Nunca cole estes valores no chat.
# Fase 1: SÓ a base de teste. Não crie nenhuma variável FORJA_PROD*.

# Quem está usando (precisa existir em "usuarios" no forja.config.yaml ou no forja.config.local.yaml)
FORJA_USUARIO=seu_usuario

# Sankhya web (navegador/Playwright) — base de TESTE
FORJA_TESTE_URL=https://SUA-BASE-TESTE.sankhyacloud.com.br
FORJA_TESTE_USUARIO=
FORJA_TESTE_SENHA=

# Gateway Sankhya (client_credentials + X-Token, como no db-sankhya). App key não é usada.
FORJA_TESTE_GATEWAY_CLIENT_ID=
FORJA_TESTE_GATEWAY_CLIENT_SECRET=
FORJA_TESTE_GATEWAY_TOKEN=

# Chave das assinaturas do forja-aprovar (mínimo 32 caracteres). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FORJA_CHAVE_APROVACAO=

# Opcionais
# FORJA_NAVEGADOR_VISIVEL=1
# FORJA_LOG=debug
