# Copie para .env (que fica fora do git) e preencha. Nunca cole estes valores no chat.
# Só a base de teste nesta fase. Não crie nenhuma variável FORJA_PROD*.

# Postgres local (docker compose). App = servidor MCP, login, forja-aprovar e forja-auditoria (sujeito ao RLS).
FORJA_DATABASE_URL=postgres://forja_app:forja-local-app@127.0.0.1:55433/forja
# Dono = migrações e forja-admin.
FORJA_DATABASE_URL_ADMIN=postgres://forja_dono:forja-local-dono@127.0.0.1:55433/forja

# 32 bytes em hex (64 caracteres): cifra credenciais e TOTP no banco. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FORJA_CHAVE_MESTRA=

# Chave do HMAC dos planos (mínimo 32 caracteres). Gere do mesmo jeito.
FORJA_CHAVE_APROVACAO=

# Só para o "forja-admin importar-config" (primeira configuração). Depois de importar, podem sair.
FORJA_TESTE_URL=https://SUA-BASE-TESTE.sankhyacloud.com.br
# Se preencher, o importar-config já grava as credenciais cifradas (senão, use "ambiente cadastrar"):
# FORJA_TESTE_USUARIO=
# FORJA_TESTE_SENHA=
# FORJA_TESTE_GATEWAY_CLIENT_ID=
# FORJA_TESTE_GATEWAY_CLIENT_SECRET=
# FORJA_TESTE_GATEWAY_TOKEN=

# Opcionais
# FORJA_NAVEGADOR_VISIVEL=1
# FORJA_LOG=debug
